# Copie este archivo como .env y ajuste los valores antes del primer despliegue:
#   cp .env.example .env

# Credenciales de PostgreSQL (se aplican solo al crear el volumen de datos por primera vez)
DB_NAME=sistema_dental
DB_USER=postgres
DB_PASSWORD=cambie-esta-contrasena

# Secreto para firmar las sesiones de los usuarios (use una cadena larga y aleatoria)
STORAGE_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio

# Puerto de la aplicación web en el servidor
APP_PORT=8080

# Puerto local del gestor Adminer (perfil "tools")
ADMINER_PORT=8081

# true = cargar datos de muestra al crear la base de datos; false = base vacía (solo usuario admin)
SEED_DEMO_DATA=true
